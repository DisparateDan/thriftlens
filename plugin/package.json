{
  "name": "thriftlens",
  "version": "1.0.7",
  "description": "ThriftLens Obsidian Plugin",
  "main": "main.js",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "deploy": "node esbuild.config.mjs production && node deploy.mjs",
    "dev:deploy": "node deploy.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate": "node tests/generate.mjs",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^20.0.0",
    "esbuild": "^0.20.0",
    "eslint-plugin-obsidianmd": "^0.1.9",
    "obsidian": "latest",
    "tsx": "^4.21.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.57.1",
    "vitest": "^4.1.0"
  }
}
